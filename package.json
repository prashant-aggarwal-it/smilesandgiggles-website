{
  "name": "smiles-giggles-foundation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:clean": "npm run clean && npm run dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "audit:site": "node scripts/audit-site.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:production": "node scripts/check-production.mjs",
    "verify": "npm run lint && npm run typecheck && npm run audit:site && npm run check:links && npm run check:production && npm run check:responsive",
    "netlify:build": "npm run audit:site && npm run check:links && npm run check:production && npm run build",
    "ci": "npm run verify && npm run build",
    "check:responsive": "node scripts/check-responsive.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "lucide-react": "1.34.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
